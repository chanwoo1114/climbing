# ---- Django ----
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,host.docker.internal
CORS_ALLOWED_ORIGINS=http://localhost:5180
LOG_LEVEL=INFO

# ---- Postgres (PostGIS) ----
POSTGRES_DB=climbing
POSTGRES_USER=climbing
POSTGRES_PASSWORD=climbing
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ---- 호스트에 노출할 포트 (다른 프로젝트와 충돌 시 여기만 바꾸면 됨) ----
WEB_PORT=8010
DB_PORT=5442
REDIS_PORT=6389

# ---- 이메일 (인증 메일 / 비밀번호 재설정) ----
# 개발 기본은 콘솔 출력(celery 로그에 본문이 찍힘). 실제 발송은 smtp 로 바꾸고 아래를 채운다.
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Climbing <noreply@localhost>
# 메일 링크가 가리킬 프론트 주소 (외부 공개 시 공유기 주소로)
FRONTEND_BASE_URL=http://localhost:5180
EMAIL_VERIFICATION_TIMEOUT=86400
PASSWORD_RESET_TIMEOUT=3600

# ---- 캐시 (throttle 카운터) ----
CACHE_URL=redis://redis:6379/2

# ---- Kakao Local API (암장 데이터 수집: manage.py import_gyms_kakao) ----
KAKAO_REST_API_KEY=

# ---- 카카오 소셜 로그인 (GET auth/kakao/authorize/ → POST auth/kakao/callback/) ----
# 비우면 위 KAKAO_REST_API_KEY 를 client_id 로 재사용한다 (같은 카카오 앱일 때).
KAKAO_CLIENT_ID=
# 카카오 콘솔에서 Client Secret 을 활성화한 경우에만
KAKAO_CLIENT_SECRET=
# 카카오 콘솔 > 카카오 로그인 > Redirect URI 에 똑같이 등록할 것.
# 비우면 {FRONTEND_BASE_URL}/auth/kakao/callback
KAKAO_REDIRECT_URI=

# ---- S3 (presigned URL 업로드: POST /api/v1/uploads/presigned-url/) ----
# 버킷 이름이 비어 있으면 발급 API 가 503 storage_not_configured 를 돌려준다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-northeast-2
# S3 호환 스토리지(MinIO/R2)를 쓸 때만. 예: http://minio:9000 — AWS 는 비워 둔다.
AWS_S3_ENDPOINT_URL=
# 업로드 파일의 공개 URL 베이스 (CloudFront 등 CDN). 비우면 버킷 URL 을 그대로 쓴다.
MEDIA_PUBLIC_BASE_URL=
# presigned URL 유효 시간(초)
S3_PRESIGNED_EXPIRE_SECONDS=300

# ---- 영상 분석 ----
ANALYSIS_MAX_VIDEO_SECONDS=120
ANALYSIS_SAMPLE_FPS=10

# ---- 알림 팬아웃: Web Push (VAPID) ----
# 비우면 푸시는 건너뛰고(WebSocket·이메일만), 구독 등록 API 는 503 push_not_configured.
# 키 생성 (컨테이너 안에서 1회):
#   dc exec web vapid --gen            → private_key.pem / public_key.pem 생성
#   dc exec web vapid --applicationServerKey   → 브라우저 pushManager.subscribe 에 넘길 공개키 (base64url)
# 아래 두 값은 위 명령이 출력한 base64url 문자열(또는 PEM 파일 내용)을 그대로 넣는다.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
# VAPID sub 클레임 — 푸시 서비스(FCM/Mozilla 등)가 문제 시 연락할 운영자 메일
WEBPUSH_VAPID_CLAIMS_EMAIL=mailto:admin@example.com
WEBPUSH_TTL_SECONDS=86400
# 이메일 팬아웃 전체 스위치 (사용자별 설정과 AND). 실제 발송은 위 EMAIL_* 설정을 따른다.
NOTIFICATION_EMAIL_ENABLED=True

# ---- AI 코칭 리포트 (POST /api/v1/analyses/{id}/report/) — Claude API ----
# https://console.anthropic.com 에서 발급. 비우면 리포트 API 가 503 coaching_not_configured.
ANTHROPIC_API_KEY=
COACHING_MODEL=claude-opus-5
COACHING_MAX_TOKENS=4096
# low | medium | high — 리포트 품질/비용 균형 (기본 medium)
COACHING_EFFORT=medium
